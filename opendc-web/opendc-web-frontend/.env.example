# Origin of the OpenDC API, without a trailing slash. Leave empty to call the same origin that
# serves the app, which is what both `quarkusDev` (Quinoa starts and proxies this dev server) and a
# self-host deployment do. Set it only for a split-origin deployment, for example
# https://api.opendc.org, or when running `pnpm dev` standalone against a server on another port.
NEXT_PUBLIC_API_BASE_URL=

# Optional deploy-under-subpath base path (no leading slash).
# NEXT_BASE_PATH=