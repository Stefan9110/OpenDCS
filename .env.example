# Copy to .env and fill in the required values. docker compose reads it from this directory.

# Required.
OPENDC_DB_PASSWORD=
# Required with docker-compose.s3.yml.
MINIO_ROOT_PASSWORD=

# Optional, shown with their defaults.
# OPENDC_VERSION=latest
# OPENDC_AUTH_MODE=anonymous
# OPENDC_HTTP_PORT=8080
# OPENDC_MEMORY_LIMIT=4g
# OPENDC_SIMULATION_CORES=2
# OPENDC_SIMULATION_MEMORY_MB=2048
# OPENDC_PUBLIC_S3_ENDPOINT=http://localhost:9000
# OPENDC_S3_PORT=9000

# Required with docker-compose.prod.yml.
# OPENDC_AUTH0_DOMAIN=
# OPENDC_AUTH0_CLIENT_ID=
# OPENDC_AUTH0_AUDIENCE=
# OPENDC_WEBSITE_VERSION=
# Auth0 subjects made administrators when they first sign in, comma separated.
# OPENDC_AUTH_ADMINS=
