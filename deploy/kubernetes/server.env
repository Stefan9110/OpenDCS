# Non-secret settings of the server, as environment variables. Secrets go in secrets.env.

# Executions run as Jobs of the launcher image, which has to be this server's version.
OPENDC_EXECUTION_DISPATCHER=kubernetes
OPENDC_DISPATCHER_KUBERNETES_IMAGE=ghcr.io/atlarge-research/opendc-launcher:latest
OPENDC_DISPATCHER_KUBERNETES_SERVICE_ACCOUNT=opendc-launcher
# The shape of one execution, and how many may run at once.
OPENDC_DISPATCHER_KUBERNETES_SLOT_CORES=4
OPENDC_DISPATCHER_KUBERNETES_SLOT_MEMORY_MB=8192
OPENDC_DISPATCHER_KUBERNETES_MAX_CONCURRENT=16

# Where launcher pods report progress: the server's Service, never a loopback address.
OPENDC_EXECUTION_TELEMETRY_URL=http://opendc-server.opendc.svc.cluster.local:8080/api/v1/telemetry
OPENDC_TELEMETRY_KIND=redis
QUARKUS_REDIS_HOSTS=redis://opendc-redis.opendc.svc.cluster.local:6379

# Traces and results live in a bucket. Pods inside the cluster use the endpoint; browsers upload
# and download through the public one.
OPENDC_STORAGE_KIND=s3
OPENDC_STORAGE_S3_BUCKET=opendc
OPENDC_STORAGE_S3_ENDPOINT=https://s3.example.org
OPENDC_STORAGE_S3_PUBLIC_ENDPOINT=https://s3.example.org
OPENDC_STORAGE_S3_REGION=us-east-1

# Sign people in through Auth0. QUARKUS_OIDC_AUTH_SERVER_URL is the tenant, with a trailing slash,
# and the audience is the identifier of the Auth0 API the frontend asks tokens for.
OPENDC_AUTH_MODE=auth0
QUARKUS_OIDC_TENANT_ENABLED=true
QUARKUS_OIDC_AUTH_SERVER_URL=https://example.eu.auth0.com/
QUARKUS_OIDC_TOKEN_AUDIENCE=https://opendc.example.org/api
OPENDC_AUTH_AUTH0_CLIENT_ID=replace-with-the-spa-client-id
# The subjects of the first administrators, comma-separated, as Auth0 names them.
OPENDC_AUTH_ADMINS=auth0|replace-me

# Launchers run elsewhere, so the server may take half of its container rather than the quarter the
# image leaves it for running simulations beside itself.
OPENDC_SERVER_OPTS=-XX:MaxRAMPercentage=50
