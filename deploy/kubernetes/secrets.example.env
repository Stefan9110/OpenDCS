# Copy to secrets.env (which git ignores) and fill in. kubectl apply -k turns it into a Secret.

OPENDC_DB_URL=jdbc:postgresql://postgres.example.org:5432/opendc
OPENDC_DB_USERNAME=opendc
OPENDC_DB_PASSWORD=

OPENDC_STORAGE_S3_ACCESS_KEY=
OPENDC_STORAGE_S3_SECRET_KEY=

# At least 32 random bytes, base64: openssl rand -base64 32. Every replica has to share it.
OPENDC_DOWNLOADS_SIGNING_KEY=
