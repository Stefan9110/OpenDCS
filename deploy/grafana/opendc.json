{
  "title": "OpenDC",
  "uid": "opendc-overview",
  "description": "Executions, the queue, the platform's capacity and the API of an OpenDC server.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["opendc"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Executions by state",
      "description": "Every replica reports the same numbers, read from the database, so this takes the maximum.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "max by (state) (opendc_executions{state=~\"queued|submitted|running\"})", "legendFormat": "{{state}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Runs waiting for an execution",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "max(opendc_units_queued)", "legendFormat": "queued" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Platform cores",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(opendc_platform_cores_allocated)", "legendFormat": "allocated" },
        { "refId": "B", "expr": "max(opendc_platform_cores_total)", "legendFormat": "total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Launches by outcome",
      "description": "Rejected launches fail their work; unavailable ones are tried again later.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (increase(opendc_executions_launched_total[$__rate_interval]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Executions ended, by reason",
      "description": "oom, timeout, walltime and unknown are retried with more resources; a steady stream of them means estimates are too low.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (increase(opendc_executions_settled_total[$__rate_interval]))", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API requests",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count[$__rate_interval]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API latency, slowest endpoints",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (method, uri) (rate(http_server_requests_seconds_sum[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server heap",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used {{instance}}" },
        { "refId": "B", "expr": "sum by (instance) (jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max {{instance}}" }
      ]
    }
  ]
}
